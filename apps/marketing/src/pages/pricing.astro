---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
---
<Layout title="AgentOps — Plans & services" description="AgentOps is free to self-host. Companies that want it operated, supported or extended can work with us directly." sheetLabel="Plans & services">
<main>
  <section style="position:relative;overflow:hidden;border-bottom:1px solid var(--border-0);background:var(--bg-0)">
    <div style="position:absolute;inset:0;pointer-events:none;background:radial-gradient(ellipse 55% 50% at 50% -10%,rgba(203,166,247,0.3),transparent 70%)"></div>
    <div style="position:relative;max-width:1240px;margin:0 auto;padding:88px 32px 96px;display:flex;flex-direction:column;align-items:center;gap:20px;text-align:center">
      <span style="font-family:var(--font-mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--accent-primary)">Plans &amp; services</span>
      <h1 style="margin:0;max-width:14em;font-size:clamp(40px,5.4vw,72px);line-height:1.02;letter-spacing:-0.04em;font-weight:800;text-wrap:balance">Free to run yourself. <span style="background:linear-gradient(95deg,#cba6f7,#f5c2e7 50%,#fab387);-webkit-background-clip:text;background-clip:text;color:transparent">We&rsquo;ll run it for your company.</span></h1>
      <p style="margin:0;max-width:38em;font-size:19px;line-height:1.5;color:var(--text-2);text-wrap:pretty">AgentOps is open source. Individuals and teams who self-host get every feature at no cost. Companies that want it operated, supported or extended can work with us directly.</p>
    </div>
    <div style="position:relative;max-width:1240px;margin:0 auto;padding:0 32px 96px;display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:18px;align-items:stretch">
      <div style="position:relative;display:flex;flex-direction:column;gap:22px;padding:30px;border-radius:18px;border:1px solid var(--border-0);background:linear-gradient(180deg,var(--bg-1),var(--bg-2))">
        <div style="display:flex;justify-content:space-between;align-items:center"><span style="font-family:var(--font-mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--accent-green)">Community</span></div>
        <div style="display:flex;flex-direction:column;gap:8px"><span style="font-size:28px;font-weight:800;letter-spacing:-0.02em;color:var(--text-0)">Open source</span><span style="font-size:36px;font-weight:800;letter-spacing:-0.03em;color:var(--accent-green)">Free</span><span style="font-size:15px;line-height:1.5;color:var(--text-2)">Self-host on your own infrastructure.</span></div>
        <div style="display:flex;flex-direction:column;gap:12px;flex:1">
          <div style="display:flex;gap:10px;font-size:15px;line-height:1.45;color:var(--text-1)"><span style="color:var(--accent-green);flex:none">&#10003;</span><span>All 35 MCP tools and every feature</span></div>
          <div style="display:flex;gap:10px;font-size:15px;line-height:1.45;color:var(--text-1)"><span style="color:var(--accent-green);flex:none">&#10003;</span><span>Local or shared team server</span></div>
          <div style="display:flex;gap:10px;font-size:15px;line-height:1.45;color:var(--text-1)"><span style="color:var(--accent-green);flex:none">&#10003;</span><span>MIT or Apache-2.0</span></div>
          <div style="display:flex;gap:10px;font-size:15px;line-height:1.45;color:var(--text-1)"><span style="color:var(--accent-green);flex:none">&#10003;</span><span>Community support on GitHub</span></div>
        </div>
        <a href="https://www.npmjs.com/package/agentops-cli" target="_blank" rel="noopener" style="text-align:center;padding:13px 18px;border-radius:999px;font-weight:700;font-size:15px;border:1px solid var(--border-1);color:var(--text-0)">Install from npm &#8599;</a>
      </div>
      <div style="position:relative;display:flex;flex-direction:column;gap:22px;padding:30px;border-radius:18px;border:1px solid var(--accent-primary);background:linear-gradient(180deg,var(--bg-1),var(--bg-2));box-shadow:0 30px 80px -30px var(--accent-primary)">
        <div style="display:flex;justify-content:space-between;align-items:center"><span style="font-family:var(--font-mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--accent-primary)">Managed</span><span style="font-size:12px;font-weight:700;padding:4px 10px;border-radius:999px;background:var(--accent-primary);color:var(--bg-0)">For companies</span></div>
        <div style="display:flex;flex-direction:column;gap:8px"><span style="font-size:28px;font-weight:800;letter-spacing:-0.02em;color:var(--text-0)">Managed suite</span><span style="font-size:36px;font-weight:800;letter-spacing:-0.03em;color:var(--accent-primary)">Contact us</span><span style="font-size:15px;line-height:1.5;color:var(--text-2)">We deploy, operate and upgrade AgentOps for your organization.</span></div>
        <div style="display:flex;flex-direction:column;gap:12px;flex:1">
          <div style="display:flex;gap:10px;font-size:15px;line-height:1.45;color:var(--text-1)"><span style="color:var(--accent-primary);flex:none">&#10003;</span><span>Deployment on your cloud or ours</span></div>
          <div style="display:flex;gap:10px;font-size:15px;line-height:1.45;color:var(--text-1)"><span style="color:var(--accent-primary);flex:none">&#10003;</span><span>Upgrades, backups and monitoring</span></div>
          <div style="display:flex;gap:10px;font-size:15px;line-height:1.45;color:var(--text-1)"><span style="color:var(--accent-primary);flex:none">&#10003;</span><span>Onboarding for your teams and repos</span></div>
          <div style="display:flex;gap:10px;font-size:15px;line-height:1.45;color:var(--text-1)"><span style="color:var(--accent-primary);flex:none">&#10003;</span><span>Priority support with response SLAs</span></div>
        </div>
        <a href="#contact" style="text-align:center;padding:13px 18px;border-radius:999px;font-weight:700;font-size:15px;background:var(--accent-primary);color:var(--bg-0)">Talk to us</a>
      </div>
      <div style="position:relative;display:flex;flex-direction:column;gap:22px;padding:30px;border-radius:18px;border:1px solid var(--border-0);background:linear-gradient(180deg,var(--bg-1),var(--bg-2))">
        <div style="display:flex;justify-content:space-between;align-items:center"><span style="font-family:var(--font-mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--accent-orange)">Custom</span></div>
        <div style="display:flex;flex-direction:column;gap:8px"><span style="font-size:28px;font-weight:800;letter-spacing:-0.02em;color:var(--text-0)">Custom solutions</span><span style="font-size:36px;font-weight:800;letter-spacing:-0.03em;color:var(--accent-orange)">Scoped per project</span><span style="font-size:15px;line-height:1.5;color:var(--text-2)">Engineering work on top of the open-source core.</span></div>
        <div style="display:flex;flex-direction:column;gap:12px;flex:1">
          <div style="display:flex;gap:10px;font-size:15px;line-height:1.45;color:var(--text-1)"><span style="color:var(--accent-orange);flex:none">&#10003;</span><span>Integrations with internal tools</span></div>
          <div style="display:flex;gap:10px;font-size:15px;line-height:1.45;color:var(--text-1)"><span style="color:var(--accent-orange);flex:none">&#10003;</span><span>Custom MCP tools and scanners</span></div>
          <div style="display:flex;gap:10px;font-size:15px;line-height:1.45;color:var(--text-1)"><span style="color:var(--accent-orange);flex:none">&#10003;</span><span>Private deployments and security review</span></div>
          <div style="display:flex;gap:10px;font-size:15px;line-height:1.45;color:var(--text-1)"><span style="color:var(--accent-orange);flex:none">&#10003;</span><span>Training for your engineers</span></div>
        </div>
        <a href="#contact" style="text-align:center;padding:13px 18px;border-radius:999px;font-weight:700;font-size:15px;border:1px solid var(--border-1);color:var(--text-0)">Describe your project</a>
      </div>
    </div>
  </section>

  <section style="border-bottom:1px solid var(--border-0);background:var(--bg-0)">
    <div style="max-width:1240px;margin:0 auto;padding:88px 32px;display:flex;flex-direction:column;gap:40px">
      <div style="display:flex;flex-wrap:wrap;gap:24px;justify-content:space-between;align-items:flex-end">
        <div style="display:flex;flex-direction:column;gap:14px;max-width:760px">
          <span style="font-family:var(--font-mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--accent-primary)">Enterprise controls</span>
          <h2 style="margin:0;font-size:clamp(32px,3.8vw,52px);line-height:1.04;letter-spacing:-0.03em;font-weight:800;text-wrap:balance">Built for the questions your security team will ask.</h2>
        </div>
        <p style="margin:0;max-width:26em;font-size:15.5px;line-height:1.55;color:var(--text-2)">Guarantees come from how it&rsquo;s built, not from policy documents. You can read every line.</p>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px">
        {[
          ['var(--accent-primary)', 'Runs on your infrastructure', 'Your cloud, your VPC, or on-prem. Managed plans can deploy into your own account.'],
          ['var(--accent-teal)', 'Zero-network scanning engine', 'Verified at build time. The core engine can’t send your code anywhere.'],
          ['var(--accent-orange)', 'Read-only by construction', 'Write-capable tools are removed from what agents are told exists.'],
          ['var(--accent-blue)', 'Roles, invites, audit log', 'Owner, Admin and Member roles. Invite-only signup. Every action logged.'],
          ['var(--accent-pink)', 'Encrypted secrets', 'Stored credentials are encrypted with your master key, which never leaves your server.'],
          ['var(--accent-green)', 'Open source, auditable', 'MIT or Apache-2.0. Review, fork, or run your own security audit.'],
        ].map(([c, title, body]) => (
          <div style="display:flex;flex-direction:column;gap:10px;padding:22px;border-radius:14px;border:1px solid var(--border-0);background:var(--bg-1)">
            <span style={`width:10px;height:10px;background:${c};transform:rotate(45deg)`}></span>
            <span style="font-size:17px;font-weight:700;color:var(--text-0)">{title}</span>
            <span style="font-size:14.5px;line-height:1.55;color:var(--text-2)">{body}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section style="border-bottom:1px solid var(--border-0);background:var(--bg-2)">
    <div style="max-width:1240px;margin:0 auto;padding:40px 32px;display:flex;flex-wrap:wrap;gap:20px;align-items:center;justify-content:space-between">
      <div style="display:flex;flex-direction:column;gap:6px"><span style="font-size:22px;font-weight:700;letter-spacing:-0.01em">Found a bug?</span><span style="font-size:15px;color:var(--text-2)">Open an issue on GitHub. Include the CLI version and what you ran.</span></div>
      <div style="display:flex;gap:10px;flex-wrap:wrap">
        <a href="https://github.com/Jesus-Glez60/agentops/issues/new" target="_blank" rel="noopener" style="padding:12px 20px;border-radius:999px;background:var(--accent-red);color:var(--bg-0);font-weight:700;font-size:15px">Report a bug &#8599;</a>
        <a href="https://github.com/Jesus-Glez60/agentops" target="_blank" rel="noopener" style="padding:12px 20px;border-radius:999px;border:1px solid var(--border-1);color:var(--text-0);font-weight:600;font-size:15px">View the source &#8599;</a>
      </div>
    </div>
  </section>

  <section id="contact" style="border-bottom:1px solid var(--border-0)">
    <div style="max-width:1240px;margin:0 auto;padding:96px 32px;display:flex;flex-wrap:wrap;gap:48px">
      <div style="flex:1 1 320px;display:flex;flex-direction:column;gap:18px">
        <span style="font-family:var(--font-mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--text-2)">Contact</span>
        <h2 style="margin:0;font-size:clamp(32px,3.6vw,48px);line-height:1.05;letter-spacing:-0.03em;font-weight:800">Tell us what your company needs.</h2>
        <p style="margin:0;font-size:16px;line-height:1.55;color:var(--text-2);max-width:30em">Managed hosting, a custom build, or a quote. We reply by email.</p>
      </div>
      <ContactForm />
    </div>
  </section>
</main>
</Layout>
