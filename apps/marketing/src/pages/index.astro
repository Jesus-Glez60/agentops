---
import Layout from '../layouts/Layout.astro';
import CopyButton from '../components/CopyButton.astro';
import SelfHostTabs from '../components/SelfHostTabs.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import KnowledgeGraph from '../components/KnowledgeGraph.tsx';
import { FEATURES } from '../data/features';
import { DEPLOY_URL } from '../lib/external-links';

const COMPARE = [
  { k: 'Finding the code', a: 'Greps, opens files, reads them in full. Then reads some of them again.', b: 'Asks the graph for the symbol. Gets the exact source and what depends on it.' },
  { k: 'Known bugs', a: 'Has no idea the last two people hit the same lock-ordering problem.', b: 'Gets the gotcha attached to that symbol in the same response.' },
  { k: 'Library docs', a: 'Works from whatever version of the docs it remembers.', b: 'Reads docs for the version actually installed.' },
  { k: 'Next session', a: 'Starts over. Re-reads. Re-pays.', b: 'Graph and notes persist. Nothing is re-derived.' },
  { k: 'Read-only mode', a: 'Is asked, politely, not to write anything.', b: 'Is never told write tools exist.' },
];

const ARCH = [
  { n: '01', stage: 'Sources', arrow: '→', title: 'Your repo, and what surrounds it', items: ['source code', 'existing notes vault', 'third-party library docs'] },
  { n: '02', stage: 'Scan', arrow: '→', title: 'AST-aware scanner', items: ['Python · JS/TS · Go', 'Rust · C++ · C#', 'zero network access'] },
  { n: '03', stage: 'Store', arrow: '→', title: 'Knowledge graph', items: ['files · symbols · deps', 'gotchas · decisions', 'SQLite or Postgres'] },
  { n: '04', stage: 'Retrieve', arrow: '→', title: 'Hybrid search', items: ['dense + BM25', 'exact name + PPR', 'gist → detail'] },
  { n: '05', stage: 'Serve', arrow: '', title: 'MCP, REST, web UI', items: ['3 MCP servers · 35 tools', 'REST API · ~90 routes', 'web UI for humans'] },
];

const CLAIMS = [
  { n: '02', t: '35 MCP tools across three servers.', d: 'Repo scanning, notes and search; semantic search and consolidation; library docs and changelogs.', check: 'connect an agent, then list its tools' },
  { n: '03', t: 'Read-only is structural, not a prompt.', d: 'Write-capable tools are filtered out of what the agent is told is available.', check: 'compare tools/list with read-only on and off' },
  { n: '04', t: 'The scanner can’t reach the network.', d: 'The core engine’s zero-network guarantee is verified when it’s built, not promised in a policy.', check: 'build the core engine yourself' },
  { n: '05', t: 'It documents itself with itself.', d: 'On first boot AgentOps registers its own docs as a docbrain library.', check: 'scrape_library slug: agentops, then search_docs' },
  { n: '06', t: 'Self-hosted, no price gate.', d: 'One Rust server, one Next.js frontend, one required env var. MIT or Apache-2.0.', check: 'AGENTOPS_SECRETS_MASTER_KEY is the only required value' },
];

const INTEGRATIONS = [
  { k: 'Interactive picker', v: 'Claude Code · Cursor · Codex CLI · Gemini CLI' },
  { k: 'Via Ruler, --agents <id>', v: 'Copilot · Windsurf · Aider · Zed · and more' },
  { k: 'Repo connection', v: 'SSH deploy key · GitHub App (OAuth)' },
  { k: 'Tasks', v: 'Linear — native tasks can push to Linear' },
  { k: 'Protocol', v: 'Any agent that speaks MCP' },
];
---
<Layout title="AgentOps — a knowledge graph your coding agent can query" sheetLabel="01–10 Overview">
<main>

<section style="position:relative;overflow:hidden;border-bottom:1px solid var(--border-0);background:var(--bg-0)">
  <div style="position:absolute;inset:0;pointer-events:none;background:radial-gradient(ellipse 60% 45% at 50% -5%,rgba(203,166,247,0.34),transparent 70%),radial-gradient(ellipse 35% 30% at 12% 38%,rgba(250,179,135,0.12),transparent 70%),radial-gradient(ellipse 35% 30% at 88% 42%,rgba(148,226,213,0.12),transparent 70%)"></div>
  <div style="position:absolute;inset:0;pointer-events:none;background-image:radial-gradient(rgba(205,214,244,0.13) 1px,transparent 1px);background-size:22px 22px;-webkit-mask-image:radial-gradient(ellipse 70% 55% at 50% 20%,#000 30%,transparent 75%);mask-image:radial-gradient(ellipse 70% 55% at 50% 20%,#000 30%,transparent 75%)"></div>
  <div style="position:relative;max-width:1240px;margin:0 auto;padding:88px 32px 0;display:flex;flex-direction:column;align-items:center;gap:28px;text-align:center">
    <span style="display:flex;align-items:center;gap:10px;padding:6px 8px 6px 6px;border-radius:999px;border:1px solid var(--border-1);background:rgba(24,24,37,0.7);font-size:13.5px;color:var(--text-1)">
      <span style="padding:3px 10px;border-radius:999px;background:var(--accent-primary);color:var(--bg-0);font-weight:700;font-size:12px">New</span>
      <span>Regression-gated local consolidation</span>
    </span>
    <h1 style="margin:0;max-width:15em;font-size:clamp(44px,6.4vw,88px);line-height:1;letter-spacing:-0.045em;font-weight:800;text-wrap:balance;color:var(--text-0)">A map of your codebase that agents <span style="background:linear-gradient(95deg,#cba6f7 10%,#f5c2e7 50%,#fab387 90%);-webkit-background-clip:text;background-clip:text;color:transparent">query instead of guessing.</span></h1>
    <p style="margin:0;font-size:clamp(17px,1.6vw,21px);line-height:1.5;color:var(--text-2);max-width:40em;text-wrap:pretty">Turn your codebase into a knowledge graph AI coding agents can actually query — scanning, hybrid search, curated gotchas/decisions, and 35 MCP tools, all self-hosted.</p>
    <div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:center;align-items:center">
      <a href={DEPLOY_URL} target="_blank" rel="noopener" style="padding:14px 24px;border-radius:999px;background:var(--accent-primary);color:var(--bg-0);font-weight:700;font-size:16px;box-shadow:0 0 0 1px rgba(203,166,247,0.5),0 10px 40px -8px rgba(203,166,247,0.7)">Get started &rarr;</a>
      <div style="display:flex;align-items:center;gap:12px;padding:8px 8px 8px 20px;border-radius:999px;border:1px solid var(--border-1);background:rgba(24,24,37,0.85);font-family:var(--font-mono);font-size:14px;color:var(--text-0)">
        <span style="color:var(--accent-orange)">$</span><span>npx agentops-cli install</span>
        <CopyButton text="npx agentops-cli install" />
      </div>
    </div>
    <p style="margin:-10px 0 0;font-size:13.5px;line-height:1.5;color:var(--text-3);max-width:40em">Then <span style="font-family:var(--font-mono);color:var(--text-1)">npx agentops-cli connect</span>. The server is a separate one-time self-host that needs one value, a master key. <a href="#selfhost" style="color:var(--text-1);text-decoration:underline;text-underline-offset:3px">See both steps</a>.</p>
    <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:10px;margin-top:4px">
      <span style="display:flex;align-items:center;gap:8px;padding:8px 14px;border-radius:999px;background:rgba(250,179,135,0.1);border:1px solid rgba(250,179,135,0.3);font-size:14px;color:var(--accent-orange);font-weight:600">Fewer tokens <span style="color:var(--text-1);font-weight:400">&middot; lookups, not bulk reads</span></span>
      <span style="display:flex;align-items:center;gap:8px;padding:8px 14px;border-radius:999px;background:rgba(203,166,247,0.1);border:1px solid rgba(203,166,247,0.3);font-size:14px;color:var(--accent-primary);font-weight:600">Fewer hallucinations <span style="color:var(--text-1);font-weight:400">&middot; real source + known gotchas</span></span>
      <span style="display:flex;align-items:center;gap:8px;padding:8px 14px;border-radius:999px;background:rgba(148,226,213,0.1);border:1px solid rgba(148,226,213,0.3);font-size:14px;color:var(--accent-teal);font-weight:600">Knowledge that stays <span style="color:var(--text-1);font-weight:400">&middot; tied to the code</span></span>
    </div>

    <div style="position:relative;width:100%;margin-top:40px;text-align:left">
      <div style="position:absolute;left:10%;right:10%;top:-30px;height:200px;background:radial-gradient(ellipse at center,rgba(203,166,247,0.35),transparent 70%);filter:blur(30px);pointer-events:none"></div>
      <div style="position:relative;padding:1px;border-radius:18px 18px 0 0;background:linear-gradient(180deg,rgba(203,166,247,0.7),rgba(137,180,250,0.25) 40%,rgba(49,50,68,0.6))">
        <div style="border-radius:17px 17px 0 0;background:var(--bg-1);overflow:hidden">
          <div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:space-between;align-items:center;padding:12px 14px 12px 18px;border-bottom:1px solid var(--border-0);background:var(--bg-2)">
            <div style="display:flex;align-items:center;gap:14px">
              <span style="display:flex;gap:7px"><span style="width:11px;height:11px;border-radius:50%;background:var(--accent-red)"></span><span style="width:11px;height:11px;border-radius:50%;background:var(--accent-yellow)"></span><span style="width:11px;height:11px;border-radius:50%;background:var(--accent-green)"></span></span>
              <span style="font-family:var(--font-mono);font-size:12px;color:var(--text-2)">agentops / Knowledge Graph <span style="color:var(--text-4)">&middot; illustrative subset of its own repo</span></span>
            </div>
          </div>
          <KnowledgeGraph client:visible dark={true} />
        </div>
      </div>
    </div>
  </div>
  <div style="position:relative;border-top:1px solid var(--border-0);background:var(--bg-2)">
    <div style="max-width:1240px;margin:0 auto;padding:26px 32px;display:flex;flex-wrap:wrap;gap:14px 40px;align-items:center;justify-content:center">
      <span style="font-family:var(--font-mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--text-3)">Works with</span>
      <span style="font-size:18px;font-weight:700;color:var(--text-1);letter-spacing:-0.01em">Claude Code</span>
      <span style="font-size:18px;font-weight:700;color:var(--text-1);letter-spacing:-0.01em">Cursor</span>
      <span style="font-size:18px;font-weight:700;color:var(--text-1);letter-spacing:-0.01em">Codex CLI</span>
      <span style="font-size:18px;font-weight:700;color:var(--text-1);letter-spacing:-0.01em">Gemini CLI</span>
      <span style="font-size:15px;color:var(--text-3)">+ Copilot, Windsurf, Aider, Zed via Ruler</span>
    </div>
  </div>
  <div style="position:relative;border-top:1px solid var(--border-0);background:var(--bg-0)">
    <div style="max-width:1240px;margin:0 auto;padding:0 32px;display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr))">
      <div style="padding:30px 20px;display:flex;flex-direction:column;gap:6px;align-items:center;text-align:center"><span style="font-size:44px;font-weight:800;letter-spacing:-0.04em;color:var(--accent-primary)">35</span><span style="font-size:14px;color:var(--text-2)">MCP tools</span></div>
      <div style="padding:30px 20px;display:flex;flex-direction:column;gap:6px;align-items:center;text-align:center"><span style="font-size:44px;font-weight:800;letter-spacing:-0.04em;color:var(--accent-pink)">3</span><span style="font-size:14px;color:var(--text-2)">MCP servers</span></div>
      <div style="padding:30px 20px;display:flex;flex-direction:column;gap:6px;align-items:center;text-align:center"><span style="font-size:44px;font-weight:800;letter-spacing:-0.04em;color:var(--accent-orange)">~90</span><span style="font-size:14px;color:var(--text-2)">REST routes, OpenAPI-documented</span></div>
      <div style="padding:30px 20px;display:flex;flex-direction:column;gap:6px;align-items:center;text-align:center"><span style="font-size:44px;font-weight:800;letter-spacing:-0.04em;color:var(--accent-teal)">6</span><span style="font-size:14px;color:var(--text-2)">languages parsed by AST</span></div>
      <div style="padding:30px 20px;display:flex;flex-direction:column;gap:6px;align-items:center;text-align:center"><span style="font-size:44px;font-weight:800;letter-spacing:-0.04em;color:var(--accent-blue)">1</span><span style="font-size:14px;color:var(--text-2)">required env var to self-host</span></div>
    </div>
  </div>
</section>

<section style="border-bottom:1px solid var(--border-0)">
  <div style="max-width:1320px;margin:0 auto;padding:96px 32px;display:flex;flex-direction:column;gap:56px">
    <div style="display:flex;flex-wrap:wrap;gap:32px;align-items:flex-end;justify-content:space-between">
      <div style="display:flex;flex-direction:column;gap:18px;max-width:820px">
        <span style="font-family:var(--font-mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--text-2)">02 &middot; The problem</span>
        <h2 style="margin:0;font-size:clamp(34px,4vw,54px);line-height:1.02;letter-spacing:-0.03em;font-weight:800;text-wrap:balance">Every session starts from zero. You pay for it three ways.</h2>
      </div>
      <p style="margin:0;max-width:30em;font-size:17px;line-height:1.5;color:var(--text-1);text-wrap:pretty">Agents re-read files to work out what a codebase does, guess at what they can&rsquo;t see, and forget what was already tried and fixed.</p>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));border-top:1px solid var(--border-0)">
      <div style="padding:28px 28px 0 0;display:flex;flex-direction:column;gap:12px;border-right:1px solid var(--border-0)">
        <span style="font-family:var(--font-mono);font-size:12px;color:var(--accent-orange)">A</span>
        <h3 style="margin:0;font-size:26px;letter-spacing:-0.02em">Money</h3>
        <p style="margin:0;font-size:16px;line-height:1.55;color:var(--text-1)">The same code, re-read and re-paid-for every session. Context that existed five sessions ago gets derived again from scratch.</p>
      </div>
      <div style="padding:28px 28px 0;display:flex;flex-direction:column;gap:12px;border-right:1px solid var(--border-0)">
        <span style="font-family:var(--font-mono);font-size:12px;color:var(--accent-orange)">B</span>
        <h3 style="margin:0;font-size:26px;letter-spacing:-0.02em">Trust</h3>
        <p style="margin:0;font-size:16px;line-height:1.55;color:var(--text-1)">Confident answers built from a function&rsquo;s name and some hope, with nothing real to check them against.</p>
      </div>
      <div style="padding:28px 0 0 28px;display:flex;flex-direction:column;gap:12px">
        <span style="font-family:var(--font-mono);font-size:12px;color:var(--accent-orange)">C</span>
        <h3 style="margin:0;font-size:26px;letter-spacing:-0.02em">Institutional knowledge</h3>
        <p style="margin:0;font-size:16px;line-height:1.55;color:var(--text-1)">The same bug gets rediscovered, or reintroduced, because nothing tied the lesson to the code it was about.</p>
      </div>
    </div>
  </div>
</section>

<section style="border-bottom:1px solid var(--border-0);background:var(--bg-2)">
  <div style="max-width:1320px;margin:0 auto;padding:96px 32px;display:flex;flex-direction:column;gap:40px">
    <div style="display:flex;flex-direction:column;gap:18px;max-width:820px">
      <span style="font-family:var(--font-mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--text-2)">03 &middot; Same task, two agents</span>
      <h2 style="margin:0;font-size:clamp(34px,4vw,54px);line-height:1.02;letter-spacing:-0.03em;font-weight:800;text-wrap:balance">&ldquo;Change how database migrations run.&rdquo;</h2>
    </div>
    <div style="border:1px solid var(--border-0);background:var(--bg-1);overflow-x:auto">
      <div style="display:grid;grid-template-columns:minmax(140px,0.8fr) minmax(220px,1.4fr) minmax(220px,1.4fr);min-width:640px">
        <div style="padding:14px 20px;border-bottom:1px solid var(--border-0)"></div>
        <div style="padding:14px 20px;border-bottom:1px solid var(--border-0);border-left:1px solid var(--border-0);font-family:var(--font-mono);font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--text-2)">Plain agent</div>
        <div style="padding:14px 20px;border-bottom:1px solid var(--border-0);border-left:1px solid var(--border-0);font-family:var(--font-mono);font-size:11px;letter-spacing:.06em;text-transform:uppercase;background:var(--border-0);color:var(--text-0)">Agent + AgentOps</div>
        {COMPARE.map((r) => (
          <>
            <div style="padding:20px;border-bottom:1px solid var(--border-0);font-weight:600;font-size:15px">{r.k}</div>
            <div style="padding:20px;border-bottom:1px solid var(--border-0);border-left:1px solid var(--border-0);font-size:15px;line-height:1.5;color:var(--text-2)">{r.a}</div>
            <div style="padding:20px;border-bottom:1px solid var(--border-0);border-left:1px solid var(--border-0);font-size:15px;line-height:1.5">{r.b}</div>
          </>
        ))}
      </div>
    </div>
  </div>
</section>

<section id="feature-index" style="border-bottom:1px solid var(--border-0)">
  <div style="max-width:1320px;margin:0 auto;padding:96px 32px;display:flex;flex-direction:column;gap:40px">
    <div style="display:flex;flex-wrap:wrap;gap:32px;align-items:flex-end;justify-content:space-between">
      <div style="display:flex;flex-direction:column;gap:18px;max-width:820px">
        <span style="font-family:var(--font-mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--text-2)">04 &middot; Index of surfaces</span>
        <h2 style="margin:0;font-size:clamp(34px,4vw,54px);line-height:1.02;letter-spacing:-0.03em;font-weight:800">Seven screens, one graph underneath.</h2>
      </div>
      <p style="margin:0;max-width:26em;font-size:16px;line-height:1.5;color:var(--text-2)">Agents reach all of it over MCP. Humans get these. Each one has its own sheet.</p>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px">
      {FEATURES.map((f) => (
        <a href={`/features/${f.id}/`} class="feature-card" style={`--card-c:${f.color};--card-glow:${f.color}26;position:relative;overflow:hidden;display:flex;flex-direction:column;gap:14px;padding:26px;border-radius:16px;border:1px solid var(--border-0);background:linear-gradient(180deg,var(--bg-1),var(--bg-2));color:var(--text-0);min-height:230px`}>
          <span style="position:absolute;right:-40px;top:-40px;width:160px;height:160px;border-radius:50%;background:radial-gradient(circle,var(--card-glow),transparent 70%);pointer-events:none"></span>
          <div style="display:flex;justify-content:space-between;align-items:center">
            <span style="width:38px;height:38px;border-radius:10px;display:flex;align-items:center;justify-content:center;background:var(--card-glow);border:1px solid var(--card-c);font-family:var(--font-mono);font-size:13px;font-weight:600;color:var(--card-c)">{f.n}</span>
            <span style="font-family:var(--font-mono);font-size:13px;color:var(--card-c)">Explore &rarr;</span>
          </div>
          <div style="display:flex;flex-direction:column;gap:8px">
            <span style="font-family:var(--font-mono);font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--card-c)">{f.name}</span>
            <span style="font-size:24px;font-weight:700;letter-spacing:-0.02em;line-height:1.15;text-wrap:balance">{f.hook}</span>
          </div>
          <span style="font-size:14.5px;line-height:1.55;color:var(--text-2)">{f.line}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<section style="position:relative;overflow:hidden;border-bottom:1px solid var(--border-0);background:var(--bg-0)">
  <div style="position:absolute;inset:0;pointer-events:none;background:radial-gradient(ellipse 50% 40% at 50% 100%,rgba(148,226,213,0.14),transparent 70%)"></div>
  <div style="position:relative;max-width:1320px;margin:0 auto;padding:96px 32px;display:flex;flex-direction:column;gap:48px">
    <div style="display:flex;flex-direction:column;gap:16px;align-items:center;text-align:center">
      <span style="font-family:var(--font-mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--accent-teal)">The loop</span>
      <h2 style="margin:0;font-size:clamp(36px,4.6vw,64px);line-height:1;letter-spacing:-0.04em;font-weight:800;text-wrap:balance">Scan once. <span style="background:linear-gradient(95deg,#94e2d5,#89b4fa 55%,#cba6f7);-webkit-background-clip:text;background-clip:text;color:transparent">Get sharper every week.</span></h2>
      <p style="margin:0;max-width:38em;font-size:17px;line-height:1.55;color:var(--text-2)">Every note your team curates feeds a small model trained on your repo. A new version only ships if it beats the current one on a held-out eval.</p>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px">
      {[
        ['01', 'cba6f7', 'Scan', 'Files, symbols and dependencies become a graph. The scanning engine never touches the network.', 'agentops install'],
        ['02', 'fab387', 'Curate', 'Gotchas and decisions are attached to the exact symbol they’re about. Import an existing vault in one pass.', 'agentops ingest-notes'],
        ['03', '89b4fa', 'Consolidate', 'A small model fine-tunes locally on your curated notes. Nothing leaves the machine.', 'local, on your hardware'],
        ['04', 'a6e3a1', 'Gate', 'The candidate is scored against a held-out eval. It ships only if retrieval doesn’t regress.', '≥ current → ship'],
      ].map(([n, c, title, body, tag]) => (
        <div style={`position:relative;display:flex;flex-direction:column;gap:12px;padding:24px;border-radius:16px;border:1px solid var(--border-0);background:linear-gradient(180deg,var(--bg-1),var(--bg-2));min-width:0`}>
          <div style="display:flex;align-items:center;justify-content:space-between">
            <span style={`width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#${c}26;border:1px solid #${c};color:#${c};font-family:var(--font-mono);font-size:13px;font-weight:600`}>{n}</span>
            <span style="font-family:var(--font-mono);font-size:18px;color:var(--border-1)">&rarr;</span>
          </div>
          <span style={`font-size:22px;font-weight:700;letter-spacing:-0.02em;color:#${c}`}>{title}</span>
          <span style="font-size:14.5px;line-height:1.55;color:var(--text-1);flex:1">{body}</span>
          <span style="font-family:var(--font-mono);font-size:12px;color:var(--text-3);padding:8px 10px;border-radius:8px;background:var(--bg-0)">{tag}</span>
        </div>
      ))}
    </div>
    <div style="display:flex;align-items:center;justify-content:center;gap:12px;font-family:var(--font-mono);font-size:13px;color:var(--text-3)">
