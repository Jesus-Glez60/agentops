          <div style="display:flex;flex-direction:column;gap:8px">
            {c.items.map((it) => (
              <div style="font-family:var(--font-mono);font-size:12.5px;line-height:1.4;color:var(--text-1);padding-left:12px;border-left:1px solid var(--border-1)">{it}</div>
            ))}
