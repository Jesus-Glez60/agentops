---
const HOSTS = [
  {
    id: 'docker',
    label: 'Docker',
    cmds: ['cp .env.example .env   # fill in AGENTOPS_SECRETS_MASTER_KEY', 'docker compose up'],
    note: 'Single image: API on :8420, web UI on :3000. SQLite by default; add --profile postgres for a bundled Postgres.',
  },
  {
    id: 'classic',
    label: 'Classic',
    cmds: [
      'curl -fsSL https://raw.githubusercontent.com/Jesus-Glez60/agentops/main/install.sh | sh',
      'agentops init',
    ],
    note: 'Downloads the platform binary and web build, then a terminal wizard asks for the master key, optional Postgres and signup mode.',
  },
  {
    id: 'pm2',
    label: 'PM2',
    cmds: ['cargo build --release --bin agentops-server', '(cd apps/web && npm ci && npm run build)', 'pm2 start ecosystem.config.js'],
    note: 'Visit /setup on first run to configure infra without editing .env by hand.',
  },
  {
    id: 'k8s',
    label: 'Kubernetes',
    cmds: ['cp deploy/k8s/secret.yaml.example deploy/k8s/secret.yaml', 'kubectl apply -f deploy/k8s/'],
    note: 'Raw manifests: Deployment, Service, Ingress, PVC, optional Postgres StatefulSet. Fill in the master key first.',
  },
];
---
<div class="self-host-tabs" style="flex:1.2 1 460px;min-width:0;border:1px solid var(--border-0);display:flex;flex-direction:column">
  <div style="padding:18px 20px;border-bottom:1px solid var(--border-0);display:flex;flex-direction:column;gap:6px">
    <span style="font-family:var(--font-mono);font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--accent-orange)">Step A &middot; one time &middot; the server</span>
    <span style="font-size:15px;line-height:1.5;color:var(--text-1)">Every method needs one value: <code style="font-family:var(--font-mono);font-size:13px;background:var(--bg-2);padding:1px 5px">AGENTOPS_SECRETS_MASTER_KEY</code>. Generate it with <code style="font-family:var(--font-mono);font-size:13px;background:var(--bg-2);padding:1px 5px">openssl rand -hex 32</code>.</span>
  </div>
  <div style="display:flex;border-bottom:1px solid var(--border-0);overflow-x:auto">
    {HOSTS.map((h, i) => (
      <button
        class="host-tab"
        data-host={h.id}
        aria-selected={i === 0 ? 'true' : 'false'}
        style={`font-family:var(--font-mono);font-size:12.5px;cursor:pointer;padding:12px 18px;border:0;border-right:1px solid var(--border-0);background:${i === 0 ? 'var(--accent-primary)' : 'transparent'};color:${i === 0 ? 'var(--bg-0)' : 'var(--text-0)'}`}
      >
        {h.label}
      </button>
    ))}
  </div>
  <div style="background:var(--bg-0);color:var(--text-0);padding:20px;font-family:var(--font-mono);font-size:13.5px;line-height:1.75;flex:1;overflow-x:auto">
    {HOSTS.map((h, i) => (
      <div class="host-panel" data-host={h.id} style={`display:${i === 0 ? 'block' : 'none'}`}>
        {h.cmds.map((l) => (
          <div style="white-space:pre"><span style="color:var(--accent-orange)">$ </span>{l}</div>
        ))}
      </div>
    ))}
  </div>
  <div style="padding:14px 20px;font-size:14px;line-height:1.5;color:var(--text-2)">
    {HOSTS.map((h, i) => (
      <span class="host-note" data-host={h.id} style={`display:${i === 0 ? 'inline' : 'none'}`}>{h.note}</span>
    ))}
  </div>
</div>

<script>
  const tabsRoot = document.querySelector('.self-host-tabs');
  if (tabsRoot) {
    const tabs = tabsRoot.querySelectorAll<HTMLButtonElement>('.host-tab');
    for (const tab of tabs) {
      tab.addEventListener('click', () => {
        const id = tab.dataset.host;
        for (const t of tabs) {
          const active = t.dataset.host === id;
          t.setAttribute('aria-selected', active ? 'true' : 'false');
          t.style.background = active ? 'var(--accent-primary)' : 'transparent';
          t.style.color = active ? 'var(--bg-0)' : 'var(--text-0)';
        }
        for (const panel of tabsRoot.querySelectorAll<HTMLElement>('.host-panel')) {
          panel.style.display = panel.dataset.host === id ? 'block' : 'none';
        }
        for (const note of tabsRoot.querySelectorAll<HTMLElement>('.host-note')) {
          note.style.display = note.dataset.host === id ? 'inline' : 'none';
        }
      });
    }
  }
</script>
