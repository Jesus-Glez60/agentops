---
import { DEPLOY_URL } from '../lib/external-links';
---
<header style="position:sticky;top:0;z-index:50;background:rgba(30,30,46,0.88);backdrop-filter:blur(8px);border-bottom:1px solid var(--border-0)">
  <div style="max-width:1320px;margin:0 auto;padding:10px 32px;min-height:60px;display:flex;align-items:center;justify-content:space-between;gap:16px 24px;flex-wrap:wrap">
    <a href="/" style="display:flex;align-items:center;gap:10px;color:var(--text-0)">
      <span style="position:relative;width:22px;height:22px;display:block">
        <span style="position:absolute;left:0;top:0;width:9px;height:9px;background:var(--text-0)"></span>
        <span style="position:absolute;right:0;bottom:0;width:10px;height:10px;border-radius:50%;background:var(--accent-orange)"></span>
        <span style="position:absolute;left:4px;top:4px;width:15px;height:1.5px;background:var(--text-0);transform-origin:0 0;transform:rotate(45deg)"></span>
      </span>
      <span style="font-weight:700;font-size:18px;letter-spacing:-0.01em">AgentOps</span>
    </a>
    <nav style="display:flex;align-items:center;gap:4px;flex-wrap:wrap;justify-content:flex-end">
      <a href="https://github.com/Jesus-Glez60/agentops" target="_blank" rel="noopener" class="nav-external" style="font-size:14px;font-weight:500;padding:9px 12px;color:var(--text-2);font-family:var(--font-mono)">GitHub &#8599;</a>
      <a href="https://www.npmjs.com/package/agentops-cli" target="_blank" rel="noopener" class="nav-external" style="font-size:14px;font-weight:500;padding:9px 12px;color:var(--text-2);font-family:var(--font-mono)">npm &#8599;</a>
      <a href="/pricing/" style="font-size:15px;font-weight:500;padding:9px 14px" class="nav-link">For companies</a>
      <a href="https://docs.agentops.dedyn.io/" target="_blank" rel="noopener" style="font-size:15px;font-weight:500;padding:9px 14px" class="nav-link">Documentation</a>
      <a href={DEPLOY_URL} target="_blank" rel="noopener" style="font-size:15px;font-weight:600;padding:9px 16px;background:var(--accent-primary);color:var(--bg-0)" class="nav-cta">Deploy it yourself</a>
    </nav>
  </div>
</header>

<style>
  .nav-link:hover {
    color: var(--text-0);
  }
  .nav-cta:hover {
    background: var(--accent-pink);
    color: var(--bg-0);
  }
  @media (max-width: 560px) {
    .nav-external {
      display: none;
    }
  }
</style>
