# agentops self-hosted configuration.
#
# There is exactly one required value below (AGENTOPS_SECRETS_MASTER_KEY).
# Everything else has a working default — a bare `cargo run -p agentops-server`
# (or `agentops serve-api`) with just the master key set will boot a fully
# functional single-operator deployment using local SQLite files under
# ~/.agentops.

# --- Required ---

# Encrypts stored deploy-key/vault secrets. Generate with:
#   openssl rand -hex 32
AGENTOPS_SECRETS_MASTER_KEY=

# --- Storage (optional — all default to sensible local paths) ---

# Root directory every service's own per-subsystem DB file/dir defaults
# under (accounts.sqlite, teams.sqlite, integrations.sqlite, modules.sqlite,
# heavy-api.sqlite, docbrain-tenants/, docbrain.db, manifest.json,
# repo-checkouts/). Default: ~/.agentops
# AGENTOPS_DATA_DIR=

# Postgres connection string for the code-graph store. If unset, falls back
# to a local SQLite file per repo (.context/graph.db).
# AGENTOPS_DATABASE_URL=

# Individual overrides — each defaults under AGENTOPS_DATA_DIR above; only
# set one of these if you need a specific file/dir to live somewhere else.
# AGENTOPS_ACCOUNTS_DB=
# AGENTOPS_TEAMS_DB=
# AGENTOPS_INTEGRATIONS_DB=
# AGENTOPS_MODULES_DB=
# AGENTOPS_HEAVY_API_DB=
# DOCBRAIN_DB_DIR=
# AGENTOPS_DOCBRAIN_DB=
# AGENTOPS_MANIFEST_PATH=
# AGENTOPS_REPO_CHECKOUTS_DIR=

# --- Networking / auth (optional) ---

# Bind address for the merged REST server (agentops-server /
# `agentops serve-api`). Default: 127.0.0.1:8420
# AGENTOPS_ADDR=

# The REST API's externally-reachable URL, used by the web app's onboarding
# checklist to build the `agentops connect --remote <url>` command it shows
# team members. The API and web app are always on different ports (8420 vs
# 3000 by default) -- if you remap either port (as the Docker/PM2 wizards'
# printed instructions suggest doing on a shared box), set this so the
# generated command actually points at the right one. Without it, the app
# guesses `<web request's hostname>:8420` (the *internal* default), which
# is wrong whenever the API port is remapped. Example:
#   AGENTOPS_PUBLIC_API_URL=http://192.168.1.10:18420
# AGENTOPS_PUBLIC_API_URL=

# SHA-256 hash of a required API key for machine (non-session) callers —
# unset means the REST API is unauthenticated. Generate a key + hash with
# `agentops api-key generate`.
# AGENTOPS_API_KEY_HASH=

# MCP tool access mode for the merged stdio server / REST /tools:
# "advisor" (read-only tools only, default) or "full" (adds write-capable
# tools like scan_repo/add_note).
# AGENTOPS_ACCESS_MODE=advisor

# Signup policy: "open" (default -- any request creates a new account +
# tenant, unlimited) or "first-user-only" (once any account exists on this
# instance, further signup requires a valid invite_token). The Docker/PM2/
# classic self-host deployment wizards all set this to "first-user-only"
# for you; leave it unset for open/multi-tenant hosting.
# AGENTOPS_SIGNUP_MODE=open

# --- Optional third-party integrations ---
# None of these are required to self-host; each just enables one feature.

# Anthropic API key for explain_symbol / doc-labeling (BYOK for the CLI's
# direct env-var path — the hosted vault flow uses POST /integrations/anthropic instead).
# AGENTOPS_ANTHROPIC_API_KEY=

# Linear API key for the CLI's direct two-way task sync (the hosted vault
# flow uses POST /integrations/linear instead).
# AGENTOPS_LINEAR_API_KEY=
# AGENTOPS_LINEAR_WEBHOOK_URL=

# GitHub App credentials — enables the "Connect repository via GitHub App"
# flow. All of these must be set together, or the App install/webhook
# routes stay disabled.
# AGENTOPS_GITHUB_APP_ID=
# AGENTOPS_GITHUB_APP_PRIVATE_KEY=
# AGENTOPS_GITHUB_APP_PRIVATE_KEY_PATH=
# AGENTOPS_GITHUB_WEBHOOK_SECRET=
# AGENTOPS_GITHUB_APP_SLUG=

# Qdrant — enables Qdrant-backed semantic search (semantic_search/
# semantic_index/search_docs_indexed/index_docs_indexed/consolidate_model).
# Without it, everything else still works; these tools/routes are simply
# absent/503.
# AGENTOPS_QDRANT_URL=
# AGENTOPS_QDRANT_COLLECTION=agentops_semantic
