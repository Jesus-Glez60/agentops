# Copy to secret.yaml, fill in real values, and DO NOT commit it.
#   openssl rand -hex 32   # for AGENTOPS_SECRETS_MASTER_KEY
apiVersion: v1
kind: Secret
metadata:
  name: agentops-secrets
type: Opaque
stringData:
  AGENTOPS_SECRETS_MASTER_KEY: "REPLACE_ME"
  # Hash from `agentops api-key generate` (keep the raw key yourself). Required:
  # the server refuses to start on 0.0.0.0 without it.
  AGENTOPS_API_KEY_HASH: "REPLACE_ME"
  # Only needed if using the postgres-statefulset.yaml or an external DB.
  AGENTOPS_DATABASE_URL: ""
