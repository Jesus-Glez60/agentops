{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "agentops hook-capture --event posttooluse",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "agentops hook-capture --event posttoolusefailure",
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-local-notes.sh\"",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit"
      },
      {
        "hooks": [
          {
            "command": "agentops hook-capture --event pretooluse",
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "agentops hook-capture --event sessionend",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "agentops hook-capture --event sessionstart",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "agentops hook-capture --event subagentstart",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "agentops hook-capture --event userpromptsubmit",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__agentops__add_note",
      "mcp__agentops__ingest_notes"
    ]
  }
}