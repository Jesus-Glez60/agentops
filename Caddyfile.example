# NOTE: this example only proxies the API (8420); it does not route the web
# app at all. If you also expose the web UI here, it now lives under /suite
# (its Next.js basePath) with the site root reserved for a future separate
# marketing app, e.g.:
#   reverse_proxy /suite/* app:3000
#   reverse_proxy / marketing:4321   # once a marketing app exists
your-domain.example.com {
	reverse_proxy app:8420
}
