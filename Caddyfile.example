# The web app lives under /suite (its Next.js basePath -- see
# apps/web/next.config.ts) and the marketing app (apps/marketing, see the
# `marketing` service in docker-compose.yml) owns the site root. The API
# (8420) is intentionally NOT routed here by default -- same reasoning as
# deploy/k8s/ingress.yaml: the frontend reaches it over localhost inside
# the container, so external routing is only needed for direct
# API-key-authed access from outside. Uncomment /api-external for that.
your-domain.example.com {
	reverse_proxy /suite/* app:3000
	reverse_proxy / marketing:4321
	# reverse_proxy /api-external/* app:8420
}
